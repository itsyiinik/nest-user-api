{
  "title": "Node.js Services",
  "uid": "nodejs-services",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{job}} RSS"
        },
        {
          "expr": "nodejs_heap_size_used_bytes",
          "legendFormat": "{{job}} Heap Used"
        },
        {
          "expr": "nodejs_heap_size_total_bytes",
          "legendFormat": "{{job}} Heap Total"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])",
          "legendFormat": "{{job}} CPU"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Event Loop Lag",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_mean_seconds",
          "legendFormat": "{{job}} Lag (mean)"
        },
        {
          "expr": "nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "{{job}} Lag (p99)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active Handles & Requests",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "nodejs_active_handles_total",
          "legendFormat": "{{job}} Handles"
        },
        {
          "expr": "nodejs_active_requests_total",
          "legendFormat": "{{job}} Requests"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Heap Used",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100000000 },
              { "color": "red", "value": 200000000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "targets": [
        { "expr": "nodejs_heap_size_used_bytes", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "RSS Memory",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200000000 },
              { "color": "red", "value": 400000000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Event Loop Lag (p99)",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds * 1000",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Active Handles",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      },
      "targets": [
        { "expr": "nodejs_active_handles_total", "legendFormat": "{{job}}" }
      ]
    }
  ]
}
