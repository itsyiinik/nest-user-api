# ─── PostgreSQL ───────────────────────────────────────────────
# Connection details for the application
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=your_db_user
DATABASE_PASS=your_db_password
DATABASE_NAME=nestdb

# Credentials passed to the docker-compose postgres container
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=nestdb

# ─── MinIO / S3 ───────────────────────────────────────────────
# MinIO admin credentials (for docker-compose)
MINIO_USER=your_minio_user
MINIO_PASSWORD=your_minio_password

# S3 client settings (must match MinIO credentials above)
S3_ACCESS_KEY=your_minio_user
S3_SECRET_KEY=your_minio_password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=main

# Folder inside the bucket where avatars are stored
MINIO_FOLDER_NAME=avatars

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ─── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# ─── MongoDB ──────────────────────────────────────────────────
# Used by the notification-service
MONGODB_USER=mongo_user
MONGODB_PASSWORD=mongo_password
MONGODB_URI=mongodb://mongo_user:mongo_password@localhost:27017/notifications?authSource=admin

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=notification-group

# ─── App ──────────────────────────────────────────────────────
LISTEN_PORT=3000

# ─── Grafana ──────────────────────────────────────────────────
# Admin password for Grafana UI (http://localhost:3003)
GRAFANA_PASSWORD=

